# Frontend Environment Configuration
# Copy this file to .env.local and update with your values

# Storage Service API URL
VITE_STORAGE_API_URL=http://localhost:8001

# Zero-Knowledge Encryption Service API URL
VITE_ZK_API_URL=http://localhost:8002

# Production example:
# VITE_STORAGE_API_URL=https://api.yourdomain.com
# VITE_ZK_API_URL=https://zk.yourdomain.com
