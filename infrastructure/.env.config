# ============================================
# Edge Cloud Storage - Non-Secret Configuration
# ============================================
# This file contains ONLY non-sensitive configuration.
# Safe to commit to git. Secrets are in secrets.enc.env (SOPS-encrypted).
#
# To generate the full .env:
#   ../scripts/decrypt-secrets.sh
# ============================================

# Mailgun Email Service Configuration
MAILGUN_ENABLED=true
MAILGUN_DOMAIN=mg.edgevaultcloud.com
MAILGUN_API_URL=https://api.mailgun.net/v3
MAILGUN_FROM_EMAIL=noreply@edgevaultcloud.com
MAILGUN_FROM_NAME=EdgeVault

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rust Data Plane Configuration
RUST_DATAPLANE_ENABLED=true
RUST_DATAPLANE_SOCKET=/run/dataplane/edge-storage-dataplane.sock
RUST_DATAPLANE_TIMEOUT=300
RUST_DATAPLANE_ROLLOUT_PERCENTAGE=100
RUST_DATAPLANE_FALLBACK_TO_PYTHON=true
RUST_DATAPLANE_FSYNC_MODE=session
RUST_DATAPLANE_MODE=full

# Company / Invoice Branding
COMPANY_NAME=EdgeVault
COMPANY_ADDRESS=
COMPANY_EMAIL=billing@edgevaultcloud.com
COMPANY_PHONE=
COMPANY_GST=
COMPANY_LOGO_URL=

# LLM Configuration
LLM_ENABLED=true
LLM_MODEL=gpt-4o-mini
LLM_API_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=1024

# Payment Gateway Configuration
RAZORPAY_ENABLED=true
RAZORPAY_CURRENCY=INR
DEFAULT_PAYMENT_GATEWAY=razorpay

# Stripe (optional)
STRIPE_ENABLED=false

# DEV_MODE: Set to true to bypass payment gateway
# WARNING: Never enable in production!
DEV_MODE=false
