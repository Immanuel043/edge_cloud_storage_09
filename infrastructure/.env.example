# ============================================
# Edge Cloud Storage - Production Configuration
# ============================================

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Generate keys:
#    openssl rand -base64 32  # Run twice, use different values
#
# 2. Set SECRET_KEY (for JWT/sessions):
#    SECRET_KEY=<first-generated-value>
#
# 3. Set ENCRYPTION_MASTER_KEY (for file encryption):
#    ENCRYPTION_MASTER_KEY=<second-generated-value>
#
# 4. CRITICAL: Keep these keys secure and backed up!
#    - Store in password manager or secrets vault
#    - Never commit to version control
#    - Losing ENCRYPTION_MASTER_KEY makes files unrecoverable
# ===========================================

# Environment
ENVIRONMENT=production

# Security Keys (REQUIRED - Generate with: openssl rand -base64 32)
# DO NOT use these placeholder values in production!
SECRET_KEY=                     # Required: JWT signing, session management
ENCRYPTION_MASTER_KEY=          # Required: File encryption master key

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage Tiering Configuration
# Files stay in hot storage (NVMe) for 7 days before moving to warm (SATA SSD)
CACHE_TO_WARM_DAYS=7

# Files stay in warm storage (SATA SSD) for 30 days before moving to cold (HDD)
WARM_TO_COLD_DAYS=30

# Files retention in cold storage (HDD) before archival/deletion
COLD_RETENTION_DAYS=365

# Enable automatic promotion to hot storage when file is accessed
PROMOTE_ON_ACCESS=true

# Upload Configuration
CHUNK_SIZE=67108864           # 64MB chunks (optimal for NVMe)
MAX_FILE_SIZE=53687091200     # 50GB max file size
STREAM_BUFFER_SIZE=16777216   # 16MB buffer
INLINE_THRESHOLD=1048576      # 1MB inline storage in Redis

# Database Configuration
DB_POOL_SIZE=100              # Base connection pool
DB_MAX_OVERFLOW=200           # Additional connections
DATABASE_URL=postgresql+asyncpg://edge_admin:secure_password@postgres:5432/edge_cloud

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_MAX_CONNECTIONS=200     # Support for high concurrency

# Background Workers
UVICORN_WORKERS=12            # Match CPU allocation
BACKGROUND_WORKERS=8          # Deduplication workers
CHUNK_PROCESSORS=4            # Parallel chunk processing

# Security
ENABLE_HTTPS=false            # Set to true in production with proper SSL

# ===========================================
# MAILGUN EMAIL CONFIGURATION (REQUIRED FOR EMAIL VERIFICATION)
# ===========================================
MAILGUN_ENABLED=true
MAILGUN_API_KEY=your-mailgun-api-key-here
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@yourdomain.com
MAILGUN_FROM_NAME=Edge Cloud Storage

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PERSISTENCE=true  # Set to true for production (persists data across restarts)
