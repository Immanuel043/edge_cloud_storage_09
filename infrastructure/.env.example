# ============================================
# Edge Cloud Storage - Environment Setup
# ============================================
#
# SECRETS MANAGEMENT (SOPS + age)
# ============================================
# Secrets are encrypted with SOPS using age keys.
#
# First-time setup:
#   1. Install tools:
#      brew install sops age   # macOS
#      apt install sops age    # Linux
#
#   2. Generate your age key (one-time):
#      age-keygen -o keys.txt
#      # macOS: move to ~/Library/Application Support/sops/age/keys.txt
#      # Linux: move to ~/.config/sops/age/keys.txt
#
#   3. Share your PUBLIC key with the team to be added to .sops.yaml
#
#   4. Decrypt and generate .env:
#      cd <repo-root>
#      ./scripts/decrypt-secrets.sh
#
# To edit secrets:
#   cd infrastructure
#   sops secrets.enc.env   # Opens in $EDITOR, re-encrypts on save
#
# To rotate a secret:
#   sops secrets.enc.env   # Edit the value
#   ../scripts/decrypt-secrets.sh   # Regenerate .env
#   docker compose up -d   # Restart affected services
#
# ============================================
# NON-SECRET CONFIGURATION (in .env.config)
# ============================================
# The following are set in .env.config (safe to commit):
#   MAILGUN_ENABLED, MAILGUN_DOMAIN, MAILGUN_FROM_EMAIL, etc.
#   FRONTEND_URL
#   RUST_DATAPLANE_* settings
#   COMPANY_* branding
#   LLM_MODEL, LLM_API_URL, LLM_MAX_TOKENS
#   RAZORPAY_ENABLED, RAZORPAY_CURRENCY
#   STRIPE_ENABLED
#   DEV_MODE
#
# ============================================
# SECRETS (in secrets.enc.env, SOPS-encrypted)
# ============================================
# Generate keys with: openssl rand -base64 32
#
# SECRET_KEY=                     # JWT signing, session management
# ENCRYPTION_MASTER_KEY=          # File encryption master key (CRITICAL - loss = data loss)
# ZK_SECRET_KEY=                  # ZK service envelope key
# SESSION_SECRET=                 # Web service session signing
# POSTGRES_PASSWORD=              # Main PostgreSQL password
# ZK_POSTGRES_PASSWORD=           # ZK PostgreSQL password
# REDIS_PASSWORD=                 # Redis password
# DATABASE_URL=                   # Full PostgreSQL connection string (with password)
# ZK_DATABASE_URL=                # ZK PostgreSQL connection string
# WEB_DATABASE_URL=               # Web service PostgreSQL connection string
# REDIS_URL=                      # Full Redis connection string (with password)
# ZK_REDIS_URL=                   # ZK Redis connection string
# MAILGUN_API_KEY=                # Mailgun API key
# RAZORPAY_KEY_ID=                # Razorpay key ID
# RAZORPAY_KEY_SECRET=            # Razorpay key secret
# RAZORPAY_WEBHOOK_SECRET=        # Razorpay webhook verification
# STRIPE_SECRET_KEY=              # Stripe secret key (optional)
# STRIPE_PUBLISHABLE_KEY=         # Stripe publishable key (optional)
# STRIPE_WEBHOOK_SECRET=          # Stripe webhook verification (optional)
# LLM_API_KEY=                    # OpenAI / LLM API key
# GRAFANA_ADMIN_PASSWORD=         # Grafana dashboard password
# DEV_MODE_CONFIRMATION_KEY=      # Dev mode safety key
# BACKUP_ENCRYPTION_KEY=          # pg_dump backup encryption key
