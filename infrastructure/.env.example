# ============================================
# Edge Cloud Storage - Production Configuration
# ============================================

# Environment
ENVIRONMENT=production
SECRET_KEY=your-secret-key-here-generate-with-openssl

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage Tiering Configuration
# Files stay in hot storage (NVMe) for 7 days before moving to warm (SATA SSD)
CACHE_TO_WARM_DAYS=7

# Files stay in warm storage (SATA SSD) for 30 days before moving to cold (HDD)
WARM_TO_COLD_DAYS=30

# Files retention in cold storage (HDD) before archival/deletion
COLD_RETENTION_DAYS=365

# Enable automatic promotion to hot storage when file is accessed
PROMOTE_ON_ACCESS=true

# Upload Configuration
CHUNK_SIZE=67108864           # 64MB chunks (optimal for NVMe)
MAX_FILE_SIZE=53687091200     # 50GB max file size
STREAM_BUFFER_SIZE=16777216   # 16MB buffer
INLINE_THRESHOLD=1048576      # 1MB inline storage in Redis

# Database Configuration
DB_POOL_SIZE=100              # Base connection pool
DB_MAX_OVERFLOW=200           # Additional connections
DATABASE_URL=postgresql+asyncpg://edge_admin:secure_password@postgres:5432/edge_cloud

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_MAX_CONNECTIONS=200     # Support for high concurrency

# Background Workers
UVICORN_WORKERS=12            # Match CPU allocation
BACKGROUND_WORKERS=8          # Deduplication workers
CHUNK_PROCESSORS=4            # Parallel chunk processing

# Security
ENABLE_HTTPS=false            # Set to true in production with proper SSL
