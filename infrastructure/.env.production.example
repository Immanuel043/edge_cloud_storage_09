# Production Environment Variables
# Copy this file to .env and update with your production values

# ============================================================================
# DATABASE INITIALIZATION MODE
# ============================================================================
# Set to 'true' for fresh database initialization (recommended for production)
# Set to 'false' to use Alembic migrations (for development)
USE_FRESH_DB_INIT=true

# Force recreate all tables (⚠️ DELETES ALL DATA - only for clean installs!)
FORCE_RECREATE=false

# Skip seed/initial data creation
SKIP_SEED=false

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=edge_cloud
DB_USER=edge_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Full database URL (auto-constructed from above)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ============================================================================
# SECURITY
# ============================================================================
# Generate a strong secret key (use: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_HERE

# Session secret (use: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_SESSION_SECRET_HERE

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
STORAGE_ROOT=/app/storage
CHUNK_SIZE=33554432           # 32MB chunks
MAX_FILE_SIZE=21474836480     # 20GB max file size
COMPRESSION_LEVEL=3

# Storage tiers (based on your NVMe hardware)
HOT_STORAGE_PATH=/app/storage/warm    # 4TB NVMe SN850X
WARM_STORAGE_PATH=/app/storage/warm   # Shared with hot
COLD_STORAGE_PATH=/app/storage/cold   # 48TB RAID-6 HDD

# ============================================================================
# SERVICES
# ============================================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
KAFKA_BROKERS=kafka:9092
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLICKHOUSE_URL=http://clickhouse:8123

# ============================================================================
# FEATURES
# ============================================================================
# Background deduplication (enabled for production)
ENABLE_DEDUPLICATION=true
DEDUP_MIN_FILE_SIZE=10485760  # 10MB minimum for dedup

# Cold storage tiering (enabled for production)
COLD_STORAGE_ENABLED=true
TIERING_INTERVAL=14400        # 4 hours

# ML Features
QUOTA_PREDICTION_ENABLED=true
STORAGE_OPTIMIZATION_ENABLED=true

# Backup (configure based on your setup)
BACKUP_ENABLED=false
BACKUP_PATH=/app/storage/backup

# ============================================================================
# PERFORMANCE
# ============================================================================
# Connection pools (based on 128GB RAM, 16-core CPU)
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100

# Redis connections
REDIS_MAX_CONNECTIONS=100

# Worker processes
WORKER_PROCESSES=8            # Half of CPU cores for workers

# ============================================================================
# MONITORING
# ============================================================================
# Logging level (production: INFO, debug: DEBUG)
LOG_LEVEL=INFO

# Performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# Metrics collection
ENABLE_METRICS=true

# ============================================================================
# FRONTEND
# ============================================================================
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ============================================================================
# EMAIL (for notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# OAUTH (optional)
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# DEVELOPMENT/TESTING
# ============================================================================
NODE_ENV=production

# Disable in production
DEBUG=false
TESTING=false

# ============================================================================
# HARDWARE-SPECIFIC SETTINGS (AMD Ryzen 9 7950X, 128GB RAM)
# ============================================================================
# Memory management
PYTHONMALLOC=malloc
MALLOC_TRIM_THRESHOLD=131072

# Use X-Accel for nginx direct file serving
USE_X_ACCEL=1

# ============================================================================
# NOTES
# ============================================================================
# 1. Replace all CHANGE_ME values with actual production secrets
# 2. Generate strong random keys using: openssl rand -hex 32
# 3. Use environment-specific passwords for each environment
# 4. Never commit this file with real secrets to git
# 5. Keep a secure backup of production credentials
