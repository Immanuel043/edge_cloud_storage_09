# Rust Data Plane Configuration
# Source this file before starting FastAPI: source .env.rust

# Enable Rust Data Plane
export RUST_DATAPLANE_ENABLED=true

# Socket path (must match Rust service)
export RUST_DATAPLANE_SOCKET=/tmp/edge-storage-dataplane.sock

# Timeout for Rust operations (seconds)
export RUST_DATAPLANE_TIMEOUT=300

# Rollout percentage (0-100)
# 100 = all traffic goes to Rust (when available)
# 50 = 50% traffic to Rust, 50% to Python
# 0 = no traffic to Rust (Python only)
export RUST_DATAPLANE_ROLLOUT_PERCENTAGE=100

# Fallback to Python if Rust fails
export RUST_DATAPLANE_FALLBACK_TO_PYTHON=true

# fsync mode: none (fastest), session (balanced), per-chunk (most durable)
export RUST_DATAPLANE_FSYNC_MODE=session

# Rust processing mode:
# - "hybrid": Rust hashing + Python encryption (~1.5-2x faster)
#   - Works now, production-ready
#   - No SCM_RIGHTS needed
# - "full": Full Rust processing with SCM_RIGHTS (~3-4x faster)
#   - ✅ Phase 2 COMPLETE - Now production-ready!
#   - Full hash + encrypt in Rust with secure key passing
export RUST_DATAPLANE_MODE=full

# Optional: Enable debug logging
# export LOG_LEVEL=DEBUG
# export RUST_LOG=debug,edge_storage_dataplane=trace
