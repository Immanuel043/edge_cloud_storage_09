"""
Refund Management System

Implements refund policies with full audit trail and compliance support.

Refund Policies:
- 7-day full refund (no questions asked)
- Partial refunds (admin approved)
- Automatic refund processing
- Gateway integration (Stripe & Razorpay)
"""

import logging
from datetime import datetime, timedelta
from typing import Optional, Dict, Any, List
from uuid import UUID, uuid4
from decimal import Decimal
from enum import Enum

from sqlalchemy import Column, String, DateTime, Numeric, Text, Index, func, select, Boolean
from sqlalchemy.dialects.postgresql import UUID as PGUUID, JSONB
from sqlalchemy.ext.asyncio import AsyncSession

from .models import Base, UserSubscription
from .audit_logger import AuditLogger, AuditEventType
from .validators import BillingValidator

logger = logging.getLogger(__name__)


class RefundReason(str, Enum):
    """Reasons for refund requests."""
    USER_REQUESTED = "user_requested"
    SERVICE_ISSUE = "service_issue"
    BILLING_ERROR = "billing_error"
    DUPLICATE_CHARGE = "duplicate_charge"
    FRAUDULENT = "fraudulent"
    POLICY_VIOLATION = "policy_violation"
    OTHER = "other"


class RefundStatus(str, Enum):
    """Status of refund requests."""
    PENDING = "pending"
    APPROVED = "approved"
    PROCESSING = "processing"
    COMPLETED = "completed"
    FAILED = "failed"
    REJECTED = "rejected"


class Refund(Base):
    """
    Refund records for all refund requests.

    Tracks refund lifecycle from request to completion.
    """
    __tablename__ = "refunds"

    id = Column(PGUUID(as_uuid=True), primary_key=True, default=uuid4)

    # Request details
    user_id = Column(PGUUID(as_uuid=True), nullable=False, index=True)
    subscription_id = Column(PGUUID(as_uuid=True), nullable=False, index=True)
    payment_id = Column(String(255), nullable=False, index=True)

    # Refund amount
    original_amount = Column(Numeric(10, 2), nullable=False)
    refund_amount = Column(Numeric(10, 2), nullable=False)
    currency = Column(String(3), nullable=False)

    # Status and reason
    status = Column(String(20), nullable=False, default=RefundStatus.PENDING.value, index=True)
    reason = Column(String(50), nullable=False)
    user_notes = Column(Text, nullable=True)
    admin_notes = Column(Text, nullable=True)

    # Gateway details
    gateway = Column(String(20), nullable=False)  # 'stripe' or 'razorpay'
    gateway_refund_id = Column(String(255), nullable=True, index=True)

    # Approval
    approved_by = Column(PGUUID(as_uuid=True), nullable=True)  # Admin who approved
    approved_at = Column(DateTime(timezone=True), nullable=True)

    # Processing
    processed_at = Column(DateTime(timezone=True), nullable=True)
    completed_at = Column(DateTime(timezone=True), nullable=True)

    # Error handling
    error_message = Column(Text, nullable=True)
    retry_count = Column(Integer, default=0)

    # Timestamps
    requested_at = Column(DateTime(timezone=True), server_default=func.now(), nullable=False)
    updated_at = Column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now())

    # Eligibility
    payment_date = Column(DateTime(timezone=True), nullable=False)
    is_within_policy = Column(Boolean, default=True)  # Within 7-day window

    __table_args__ = (
        Index('idx_refunds_user_status', 'user_id', 'status'),
        Index('idx_refunds_gateway', 'gateway'),
        Index('idx_refunds_requested_at', 'requested_at'),
    )


class RefundManager:
    """
    Manages refund requests and processing.

    Features:
    - Automatic eligibility checking (7-day policy)
    - Gateway-agnostic refund processing
    - Full audit trail
    - Admin approval workflow
    """

    FULL_REFUND_DAYS = 7  # 7-day full refund policy

    def __init__(self, db: AsyncSession):
        self.db = db
        self.audit_logger = AuditLogger(db)

    async def request_refund(
        self,
        user_id: UUID,
        subscription_id: UUID,
        payment_id: str,
        original_amount: Decimal,
        currency: str,
        payment_date: datetime,
        gateway: str,
        refund_amount: Optional[Decimal] = None,
        reason: RefundReason = RefundReason.USER_REQUESTED,
        user_notes: Optional[str] = None
    ) -> Refund:
        """
        Submit a refund request.

        Args:
            user_id: User requesting refund
            subscription_id: Subscription being refunded
            payment_id: Payment to refund
            original_amount: Original payment amount
            currency: Currency code
            payment_date: When payment was made
            gateway: Payment gateway
            refund_amount: Amount to refund (None = full refund)
            reason: Refund reason
            user_notes: User's explanation

        Returns:
            Created refund request
        """
        # Validate inputs
        original_amount = BillingValidator.validate_amount(original_amount, "original_amount")
        currency = BillingValidator.validate_currency(currency)
        gateway = BillingValidator.validate_gateway(gateway)

        # Default to full refund if not specified
        if refund_amount is None:
            refund_amount = original_amount
        else:
            refund_amount = BillingValidator.validate_refund_amount(
                refund_amount,
                original_amount,
                Decimal('0.00')
            )

        # Check if within 7-day refund policy
        days_since_payment = (datetime.utcnow() - payment_date).days
        is_within_policy = days_since_payment <= self.FULL_REFUND_DAYS

        # Auto-approve if within policy and full refund
        if is_within_policy and refund_amount == original_amount:
            status = RefundStatus.APPROVED
            approved_at = datetime.utcnow()
            logger.info(f"Auto-approved refund (within {self.FULL_REFUND_DAYS}-day policy)")
        else:
            status = RefundStatus.PENDING
            approved_at = None
            logger.info("Refund requires manual approval (outside policy or partial refund)")

        # Create refund record
        refund = Refund(
            user_id=user_id,
            subscription_id=subscription_id,
            payment_id=payment_id,
            original_amount=original_amount,
            refund_amount=refund_amount,
            currency=currency,
            status=status.value,
            reason=reason.value if isinstance(reason, RefundReason) else reason,
            user_notes=user_notes,
            gateway=gateway,
            payment_date=payment_date,
            is_within_policy=is_within_policy,
            approved_at=approved_at
        )

        self.db.add(refund)
        await self.db.commit()
        await self.db.refresh(refund)

        # Audit log
        await self.audit_logger.log_event(
            event_type=AuditEventType.PAYMENT_REFUNDED,
            user_id=user_id,
            resource_type='refund',
            resource_id=str(refund.id),
            gateway=gateway,
            event_data={
                'payment_id': payment_id,
                'original_amount': float(original_amount),
                'refund_amount': float(refund_amount),
                'currency': currency,
                'reason': reason.value if isinstance(reason, RefundReason) else reason,
                'auto_approved': is_within_policy and refund_amount == original_amount,
                'days_since_payment': days_since_payment
            },
            status='pending' if status == RefundStatus.PENDING else 'success'
        )

        logger.info(
            f"Refund requested: {refund.id}",
            extra={
                "refund_id": str(refund.id),
                "user_id": str(user_id),
                "amount": float(refund_amount),
                "status": status.value
            }
        )

        # Auto-process if approved
        if status == RefundStatus.APPROVED:
            await self.process_refund(refund)

        return refund

    async def approve_refund(
        self,
        refund_id: UUID,
        admin_id: UUID,
        admin_email: str,
        admin_notes: Optional[str] = None
    ) -> Refund:
        """
        Approve a refund request (admin only).

        Args:
            refund_id: Refund to approve
            admin_id: Admin approving refund
            admin_email: Admin email
            admin_notes: Admin notes

        Returns:
            Approved refund

        Raises:
            ValueError: If refund not found or already processed
        """
        result = await self.db.execute(
            select(Refund).where(Refund.id == refund_id)
        )
        refund = result.scalar_one_or_none()

        if not refund:
            raise ValueError(f"Refund not found: {refund_id}")

        if refund.status not in [RefundStatus.PENDING.value, RefundStatus.REJECTED.value]:
            raise ValueError(f"Refund cannot be approved (current status: {refund.status})")

        # Approve refund
        refund.status = RefundStatus.APPROVED.value
        refund.approved_by = admin_id
        refund.approved_at = datetime.utcnow()
        refund.admin_notes = admin_notes

        await self.db.commit()
        await self.db.refresh(refund)

        # Audit log (admin action)
        await self.audit_logger.log_admin_action(
            event_type=AuditEventType.ADMIN_REFUND_ISSUED,
            admin_id=admin_id,
            admin_email=admin_email,
            user_id=refund.user_id,
            action='approve_refund',
            details={
                'refund_id': str(refund_id),
                'amount': float(refund.refund_amount),
                'currency': refund.currency,
                'reason': refund.reason,
                'admin_notes': admin_notes
            }
        )

        logger.info(
            f"Refund approved by admin {admin_email}",
            extra={"refund_id": str(refund_id), "admin_id": str(admin_id)}
        )

        # Process the refund
        await self.process_refund(refund)

        return refund

    async def reject_refund(
        self,
        refund_id: UUID,
        admin_id: UUID,
        admin_email: str,
        reason: str
    ) -> Refund:
        """
        Reject a refund request (admin only).

        Args:
            refund_id: Refund to reject
            admin_id: Admin rejecting refund
            admin_email: Admin email
            reason: Rejection reason

        Returns:
            Rejected refund
        """
        result = await self.db.execute(
            select(Refund).where(Refund.id == refund_id)
        )
        refund = result.scalar_one_or_none()

        if not refund:
            raise ValueError(f"Refund not found: {refund_id}")

        if refund.status != RefundStatus.PENDING.value:
            raise ValueError(f"Refund cannot be rejected (current status: {refund.status})")

        # Reject refund
        refund.status = RefundStatus.REJECTED.value
        refund.admin_notes = reason

        await self.db.commit()
        await self.db.refresh(refund)

        # Audit log
        await self.audit_logger.log_admin_action(
            event_type=AuditEventType.ADMIN_REFUND_ISSUED,
            admin_id=admin_id,
            admin_email=admin_email,
            user_id=refund.user_id,
            action='reject_refund',
            details={
                'refund_id': str(refund_id),
                'reason': reason
            }
        )

        logger.info(
            f"Refund rejected by admin {admin_email}",
            extra={"refund_id": str(refund_id), "reason": reason}
        )

        return refund

    async def process_refund(self, refund: Refund) -> Dict[str, Any]:
        """
        Process an approved refund through payment gateway.

        Args:
            refund: Approved refund to process

        Returns:
            Processing result
        """
        if refund.status != RefundStatus.APPROVED.value:
            raise ValueError(f"Refund must be approved first (current status: {refund.status})")

        refund.status = RefundStatus.PROCESSING.value
        refund.processed_at = datetime.utcnow()
        await self.db.commit()

        try:
            # Process through payment gateway
            from .payment_service import PaymentService

            payment_service = PaymentService(gateway=refund.gateway)

            result = await payment_service.create_refund(
                payment_id=refund.payment_id,
                amount=refund.refund_amount,
                currency=refund.currency,
                reason=refund.reason,
                metadata={
                    'refund_id': str(refund.id),
                    'user_id': str(refund.user_id),
                    'subscription_id': str(refund.subscription_id)
                }
            )

            if result.get('success'):
                # Refund successful
                refund.status = RefundStatus.COMPLETED.value
                refund.gateway_refund_id = result.get('refund_id')
                refund.completed_at = datetime.utcnow()

                logger.info(
                    f"Refund processed successfully: {refund.id}",
                    extra={"refund_id": str(refund.id), "gateway_refund_id": result.get('refund_id')}
                )

                # Audit log
                await self.audit_logger.log_event(
                    event_type=AuditEventType.PAYMENT_REFUNDED,
                    user_id=refund.user_id,
                    resource_type='refund',
                    resource_id=str(refund.id),
                    gateway=refund.gateway,
                    status='success',
                    event_data={
                        'gateway_refund_id': result.get('refund_id'),
                        'amount': float(refund.refund_amount),
                        'currency': refund.currency
                    },
                    notes="Refund processed successfully"
                )

            else:
                # Refund failed
                refund.status = RefundStatus.FAILED.value
                refund.error_message = result.get('error', 'Unknown error')
                refund.retry_count += 1

                logger.error(
                    f"Refund processing failed: {refund.id}",
                    extra={"refund_id": str(refund.id), "error": result.get('error')}
                )

            await self.db.commit()
            return result

        except Exception as e:
            refund.status = RefundStatus.FAILED.value
            refund.error_message = str(e)
            refund.retry_count += 1
            await self.db.commit()

            logger.error(f"Error processing refund {refund.id}: {e}", exc_info=True)

            return {'success': False, 'error': str(e)}

    async def get_user_refunds(
        self,
        user_id: UUID,
        limit: int = 50
    ) -> List[Refund]:
        """
        Get all refunds for a user.

        Args:
            user_id: User ID
            limit: Maximum number of refunds to return

        Returns:
            List of refunds
        """
        result = await self.db.execute(
            select(Refund).where(
                Refund.user_id == user_id
            ).order_by(Refund.requested_at.desc()).limit(limit)
        )

        return result.scalars().all()

    async def get_pending_refunds(self, limit: int = 100) -> List[Refund]:
        """
        Get all pending refunds for admin review.

        Returns:
            List of pending refunds
        """
        result = await self.db.execute(
            select(Refund).where(
                Refund.status == RefundStatus.PENDING.value
            ).order_by(Refund.requested_at.asc()).limit(limit)
        )

        return result.scalars().all()

    async def retry_failed_refund(self, refund_id: UUID) -> Dict[str, Any]:
        """
        Retry a failed refund.

        Args:
            refund_id: Refund to retry

        Returns:
            Retry result
        """
        result = await self.db.execute(
            select(Refund).where(Refund.id == refund_id)
        )
        refund = result.scalar_one_or_none()

        if not refund:
            raise ValueError(f"Refund not found: {refund_id}")

        if refund.status != RefundStatus.FAILED.value:
            raise ValueError(f"Only failed refunds can be retried (current status: {refund.status})")

        if refund.retry_count >= 3:
            raise ValueError("Maximum retry attempts reached (3)")

        # Reset to approved for processing
        refund.status = RefundStatus.APPROVED.value
        await self.db.commit()

        return await self.process_refund(refund)
