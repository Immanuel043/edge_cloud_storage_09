# Trash Cleanup Cron Job
# Runs daily at 2:00 AM to delete files older than 30 days from trash

# Minute Hour Day Month DayOfWeek Command
0 2 * * * cd /app && python3 -m app.workers.trash_cleanup >> /var/log/trash_cleanup.log 2>&1

# Alternative: Run every hour (uncomment to use)
# 0 * * * * cd /app && python3 -m app.workers.trash_cleanup >> /var/log/trash_cleanup.log 2>&1
