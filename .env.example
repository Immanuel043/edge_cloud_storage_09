# =============================================================================
# Edge Cloud Storage - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Quick setup:
#   cp .env.example .env
#   nano .env  # Edit with your values
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME=Edge Cloud Storage
VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true  # Set to false in production

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
SECRET_KEY=your-secret-key-here-CHANGE-THIS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# HTTPS (Recommended for production)
ENABLE_HTTPS=false  # Set to true with valid certificates

# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://edge_admin:secure_password@localhost:5432/edge_cloud
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edge_cloud
DB_USER=edge_admin
DB_PASSWORD=secure_password  # CHANGE THIS
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# REDIS - Cache & Queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave empty if no password
REDIS_MAX_CONNECTIONS=50

# -----------------------------------------------------------------------------
# ELASTICSEARCH - Search & Analytics
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=edge_storage
ELASTICSEARCH_USERNAME=  # If authentication enabled
ELASTICSEARCH_PASSWORD=  # If authentication enabled

# -----------------------------------------------------------------------------
# KAFKA - Message Queue
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_UPLOADS=file_uploads
KAFKA_TOPIC_EVENTS=storage_events
KAFKA_CONSUMER_GROUP=edge_storage_consumers

# -----------------------------------------------------------------------------
# CLICKHOUSE - Analytics (Optional)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=edge_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# STORAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Storage Root Path
STORAGE_ROOT=./storage
CACHE_PATH=./storage/cache  # NVMe/SSD for hot data
WARM_PATH=./storage/warm    # SSD for active data
COLD_PATH=./storage/cold    # HDD for archive
TEMP_PATH=./storage/temp    # Temporary uploads
BACKUP_PATH=./storage/backup  # Local backups

# Upload Limits
CHUNK_SIZE=67108864  # 64MB chunks
MAX_FILE_SIZE=21474836480  # 20GB max file size
COMPRESSION_LEVEL=3  # Zstandard compression (1-22, 3 is balanced)

# Storage Thresholds
INLINE_THRESHOLD=1048576  # 1MB - store in Redis
SINGLE_OBJECT_THRESHOLD=104857600  # 100MB - store as single file

# Auto-Tiering Configuration
CACHE_TO_WARM_DAYS=7   # Move to warm storage after 7 days
WARM_TO_COLD_DAYS=30   # Move to cold storage after 30 days
COLD_TO_ARCHIVE_DAYS=90  # Archive after 90 days

# -----------------------------------------------------------------------------
# BACKUP & REPLICATION
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=edge-cloud-backup  # S3 bucket for backups
BACKUP_NODE_URL=  # URL of backup storage node (if any)

# AWS S3 Configuration (for backups)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# FILE VERSIONING
# -----------------------------------------------------------------------------
VERSION_RETENTION_DAYS=90  # Keep versions for 90 days
MAX_VERSIONS_PER_FILE=50   # Max number of versions per file
AUTO_VERSION_ON_UPDATE=true  # Auto-create version on file update

# -----------------------------------------------------------------------------
# USER QUOTAS (in bytes)
# -----------------------------------------------------------------------------
QUOTA_INDIVIDUAL=107374182400  # 100GB for individual users
QUOTA_BUSINESS=1099511627776   # 1TB for business users
QUOTA_ENTERPRISE=10995116277760  # 10TB for enterprise users

# -----------------------------------------------------------------------------
# ML FEATURES CONFIGURATION
# -----------------------------------------------------------------------------
ML_FEATURES_ENABLED=true  # Master switch for all ML features

# CPU Optimization (adjust based on your hardware)
ML_CPU_THREADS=32  # For AMD Ryzen 9 7950X (16C/32T)
ML_BATCH_SIZE=100  # Batch size for ML processing

# 1. Quota Prediction
QUOTA_PREDICTION_ENABLED=true
QUOTA_PREDICTION_MIN_DATA_POINTS=7  # Minimum days of data required
QUOTA_PREDICTION_WORKER_INTERVAL=86400  # Run every 24 hours (seconds)
QUOTA_ALERT_THRESHOLD_70=0.70  # Alert at 70% usage
QUOTA_ALERT_THRESHOLD_85=0.85  # Alert at 85% usage
QUOTA_ALERT_THRESHOLD_95=0.95  # Alert at 95% usage
QUOTA_DEPLETION_WARNING_DAYS=30  # Warn if quota will deplete in 30 days

# 2. Storage Optimization
STORAGE_OPTIMIZATION_ENABLED=true
STORAGE_OPT_ANALYSIS_INTERVAL=86400  # Analyze every 24 hours (seconds)
STORAGE_OPT_MIN_SAVINGS_THRESHOLD=10485760  # Min 10MB savings to suggest

# 3. Auto-Organization
AUTO_ORGANIZATION_ENABLED=true
AUTO_ORG_MIN_FILES=10  # Minimum files required to trigger organization
AUTO_ORG_CLUSTERING_ALGORITHM=kmeans  # kmeans or dbscan
AUTO_ORG_MAX_CLUSTERS=10  # Maximum number of clusters

# 4. Content Recommendations
CONTENT_RECOMMENDATIONS_ENABLED=true
RECOMMENDATIONS_MAX_RESULTS=10  # Max recommendations to return
RECOMMENDATIONS_MIN_SIMILARITY=0.5  # Minimum similarity score (0-1)
RECOMMENDATIONS_USE_COLLABORATIVE=true  # Enable collaborative filtering
RECOMMENDATION_CACHE_TTL_HOURS=24  # Cache recommendations for 24 hours

# -----------------------------------------------------------------------------
# ADVANCED UPLOAD FEATURES
# -----------------------------------------------------------------------------
# URL Upload
URL_UPLOAD_ENABLED=true
URL_UPLOAD_MAX_SIZE=5368709120  # 5GB max for URL downloads
URL_UPLOAD_TIMEOUT=600  # 10 minutes timeout
URL_UPLOAD_CONCURRENT_LIMIT=5  # Max concurrent downloads per user

# Folder Upload
FOLDER_UPLOAD_ENABLED=true
FOLDER_MAX_DEPTH=10  # Maximum folder nesting depth
FOLDER_MAX_FILES=1000  # Maximum files per folder upload
FOLDER_MAX_TOTAL_SIZE=10737418240  # 10GB max total size

# -----------------------------------------------------------------------------
# SECURITY & VIRUS SCANNING
# -----------------------------------------------------------------------------
# ClamAV Antivirus
CLAMAV_ENABLED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60  # Scan timeout in seconds

# Data Loss Prevention (DLP)
DLP_ENABLED=true
DLP_SCAN_ON_UPLOAD=true
DLP_PATTERNS=ssn,credit_card,email,phone  # Patterns to detect

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100  # Max requests per minute per IP
RATE_LIMIT_PER_HOUR=1000   # Max requests per hour per IP

# -----------------------------------------------------------------------------
# OCR & AI FEATURES
# -----------------------------------------------------------------------------
# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGE=eng  # Language code for Tesseract
OCR_DPI=300  # Image DPI for OCR
OCR_BACKEND=tesseract  # tesseract or easyocr

# AI Tagging
AI_TAGGING_ENABLED=true
AI_TAGGING_MODEL=distilbert-base-uncased  # Hugging Face model
AI_TAGGING_MIN_CONFIDENCE=0.7  # Minimum confidence for tags

# -----------------------------------------------------------------------------
# SEARCH & INDEXING
# -----------------------------------------------------------------------------
SEARCH_ENABLED=true
SEARCH_AUTO_INDEX=true  # Automatically index new files
SEARCH_REINDEX_INTERVAL=3600  # Re-index modified files every hour
FULL_TEXT_SEARCH_ENABLED=true  # Search inside file contents

# -----------------------------------------------------------------------------
# MONITORING & METRICS
# -----------------------------------------------------------------------------
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin  # CHANGE THIS

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE=./logs/edge_storage.log

# Sentry Error Tracking (Optional)
SENTRY_ENABLED=false
SENTRY_DSN=  # Your Sentry DSN URL

# -----------------------------------------------------------------------------
# CORS & FRONTEND
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Optional)
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@edgestorage.com
SMTP_TLS=true

# -----------------------------------------------------------------------------
# WEBSOCKET
# -----------------------------------------------------------------------------
WEBSOCKET_ENABLED=true
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_PING_INTERVAL=30  # Ping every 30 seconds
WEBSOCKET_PING_TIMEOUT=10   # Timeout after 10 seconds

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------
# API Workers
UVICORN_WORKERS=4  # Number of API workers (CPUs * 2 + 1)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8001

# Connection Pooling
ASYNC_MAX_CONNECTIONS=100
ASYNC_POOL_RECYCLE=3600  # Recycle connections every hour

# Caching
CACHE_DEFAULT_TTL=3600  # Default cache TTL in seconds
CACHE_MAX_SIZE=1000  # Max items in memory cache

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_FILE_VERSIONING=true
FEATURE_FILE_SHARING=true
FEATURE_COLLABORATIVE_EDITING=false  # Coming soon
FEATURE_VIDEO_TRANSCODING=false  # Coming soon
FEATURE_MOBILE_APP=false  # Coming soon

# -----------------------------------------------------------------------------
# DEVELOPMENT & TESTING
# -----------------------------------------------------------------------------
# Only for development
DEV_MODE=false
DEV_AUTO_RELOAD=true
DEV_MOCK_EXTERNAL_SERVICES=false

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_pass@localhost:5432/test_edge_cloud
TEST_REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# DOCKER CONFIGURATION
# -----------------------------------------------------------------------------
# These are used by docker-compose.yml
COMPOSE_PROJECT_NAME=edge-storage
DOCKER_REGISTRY=  # Your Docker registry if using custom images

# Resource Limits (for docker-compose)
STORAGE_SERVICE_MEMORY=8G
STORAGE_SERVICE_CPUS=4.0
POSTGRES_MEMORY=1G
REDIS_MEMORY=2G
ELASTICSEARCH_MEMORY=1G

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# NEXT STEPS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Generate SECRET_KEY: openssl rand -base64 32
# 4. Update all CHANGE-THIS placeholders
# 5. Start services: docker-compose up -d
# 6. Run migrations: alembic upgrade head
# 7. Create admin user via API
#
# For production deployment, see: docs/PRODUCTION_READY_CHECKLIST.md
# =============================================================================
